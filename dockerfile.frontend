FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

#COPY pyproject.toml uv.lock ./
RUN pip install uv
RUN uv init && uv add streamlit httpx

COPY ./src/test_ui ./src/test_ui

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "src/test_ui/admin/panel.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
